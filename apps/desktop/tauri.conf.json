{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Broadcast",
  "version": "1.1.27",
  "identifier": "com.iinoshirozheng.broadcast",
  "build": {
    "beforeBuildCommand": "pnpm build:web && cargo xtask sidecar",
    "beforeDevCommand": {
      "script": "pnpm build:web && cargo xtask sidecar",
      "wait": true
    }
  },
  "app": {
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "在 Codex 客户端中打开本地任务面板",
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/broadcast-cli"],
    "resources": {
      "../web/dist/": "web/",
      "../../skills/manage-broadcast/": "skills/manage-broadcast/"
    },
    "icon": ["../web/public/codex-app-icon.png", "icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYzNEY0N0NEM0QzRjgwNzIKUldSeWdEODl6VWRQOC9idG11cnM3L2g1anpCVEpyUWFDL1F1S2pRM09RK3dseXRVTDhLem1iKy8K",
      "endpoints": [
        "https://github.com/iinoshirozheng/broadcast/releases/latest/download/latest.json"
      ]
    }
  }
}
