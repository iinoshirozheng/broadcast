{
  "name": "broadcast",
  "version": "1.1.27",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.3 || >=24.8.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "pnpm --filter @broadcast/web dev",
    "dev:cloud": "pnpm build:web && wrangler dev --local",
    "build:web": "pnpm --filter @broadcast/web build",
    "typecheck": "pnpm --filter @broadcast/web typecheck",
    "test": "node --test \"test/*.test.mjs\" && pnpm --filter @broadcast/web test",
    "test:e2e": "e2e run",
    "test:cloud": "node --test test/cloud-shared-worker.test.mjs",
    "app:prepare": "pnpm build:web && node scripts/prepare-tauri-app.mjs",
    "app:dev": "pnpm app:prepare && tauri dev",
    "app:build": "pnpm app:prepare --target universal-apple-darwin && CI=true node scripts/tauri-build.mjs --target universal-apple-darwin --bundles app,dmg --config '{\"bundle\":{\"createUpdaterArtifacts\":false}}'",
    "app:build:linux:x64": "pnpm app:prepare --target x86_64-unknown-linux-gnu && node scripts/tauri-build.mjs --target x86_64-unknown-linux-gnu --bundles deb,appimage --ci --config apps/desktop/tauri.linux.conf.json",
    "app:build:windows": "pnpm app:prepare --target x86_64-pc-windows-msvc && node scripts/tauri-build.mjs --target x86_64-pc-windows-msvc --bundles nsis --no-sign --ci --config apps/desktop/tauri.windows.conf.json",
    "app:preflight": "node scripts/preflight-macos-app.mjs",
    "app:verify-packaged-broadcast": "node scripts/verify-packaged-broadcast.mjs",
    "app:verify-release": "node scripts/verify-macos-release.mjs",
    "tauri": "tauri",
    "cloud:migrate:local": "wrangler d1 migrations apply broadcast-db --local",
    "cloud:migrate": "wrangler d1 migrations apply broadcast-db --remote",
    "cloud:deploy:dry-run": "pnpm build:web && wrangler deploy --dry-run",
    "cloud:deploy": "pnpm build:web && wrangler deploy",
    "cloud:data": "node scripts/migrate-to-cloud.mjs",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@e2e-dev/web": "0.15.2",
    "@tauri-apps/cli": "2.11.4",
    "e2e": "0.21.2",
    "miniflare": "^4.20260722.0",
    "wrangler": "^4.120.0",
    "ws": "^8.21.3"
  }
}
