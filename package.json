{
  "name": "broadcast",
  "version": "1.1.27",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.3 || >=24.8.0"
  },
  "scripts": {
    "dev": "cargo xtask dev",
    "dev:web": "pnpm --filter @broadcast/web dev",
    "dev:cloud": "pnpm build:web && wrangler dev --local",
    "build:web": "pnpm --filter @broadcast/web build",
    "typecheck": "tsc -p . && pnpm --filter @broadcast/web typecheck",
    "test": "node --test \"test/*.test.ts\" && pnpm --filter @broadcast/web test",
    "test:e2e": "e2e run",
    "test:cloud": "node --test test/cloud-shared-worker.test.ts",
    "app:dev": "tauri dev",
    "app:build": "CI=true tauri build --target universal-apple-darwin --bundles app,dmg --config '{\"bundle\":{\"createUpdaterArtifacts\":false}}'",
    "app:build:linux:x64": "tauri build --target x86_64-unknown-linux-gnu --bundles deb,appimage --ci",
    "app:build:windows": "tauri build --target x86_64-pc-windows-msvc --bundles nsis --no-sign --ci",
    "tauri": "tauri",
    "cloud:migrate:local": "wrangler d1 migrations apply broadcast-db --local",
    "cloud:migrate": "wrangler d1 migrations apply broadcast-db --remote",
    "cloud:deploy:dry-run": "pnpm build:web && wrangler deploy --dry-run",
    "cloud:deploy": "pnpm build:web && wrangler deploy",
    "cloud:data": "node scripts/migrate-to-cloud.ts",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@cloudflare/workers-types": "^5.20261114.1",
    "@e2e-dev/web": "0.15.2",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^26.6.6",
    "devtools-protocol": "^0.0.1744848",
    "e2e": "0.21.2",
    "miniflare": "^4.20260722.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.120.0",
    "ws": "^8.21.3"
  }
}
