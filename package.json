{
  "name": "broadcast",
  "version": "1.1.27",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.3 || >=24.8.0"
  },
  "scripts": {
    "dev": "cargo xtask dev",
    "dev:web": "pnpm --filter @broadcast/web dev",
    "build:web": "pnpm --filter @broadcast/web build",
    "typecheck": "tsc -p . && pnpm --filter @broadcast/web typecheck",
    "test": "node --test \"test/*.test.ts\" && pnpm --filter @broadcast/web test",
    "test:e2e": "e2e run",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@e2e-dev/web": "0.15.2",
    "@types/node": "^26.6.6",
    "e2e": "0.21.2",
    "typescript": "^7.0.2"
  }
}
